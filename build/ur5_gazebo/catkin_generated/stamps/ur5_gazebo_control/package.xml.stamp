<?xml version="1.0"?>
<package format="2">
  <name>ur5_gazebo_control</name>
  <version>0.0.0</version>
  <description>UR5 Gazebo Control</description>
  <maintainer email="jiaid@todo.todo">jiaid</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>ur_description</depend>
  <depend>ros_control</depend>
  <depend>ros_controllers</depend>
  <depend>gazebo_ros</depend>
  <depend>controller_manager</depend>
  <depend>rospy</depend>
  <depend>trajectory_msgs</depend>

</package>